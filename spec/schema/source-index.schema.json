{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricochet.local/schema/source-index.schema.json",
  "title": "ROUNDS fidelity source index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "accessedOn", "sources"],
  "properties": {
    "$schema": { "const": "./schema/source-index.schema.json" },
    "schemaVersion": { "const": 1 },
    "accessedOn": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "url", "accessedOn", "kind", "scope", "reliability"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "accessedOn": { "type": "string", "format": "date" },
        "kind": {
          "enum": ["official-store", "official-announcement", "runtime-observation", "build-index", "gameplay-recording", "community-reference"]
        },
        "scope": { "type": "string", "minLength": 1 },
        "reliability": { "enum": ["high", "medium", "low"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
