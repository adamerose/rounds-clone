{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricochet.local/schema/mechanics.schema.json",
  "title": "RICOCHET sourced mechanics specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "targetBuild", "facts"],
  "properties": {
    "$schema": { "const": "./schema/mechanics.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["match", "controls", "player", "combat", "camera"] },
    "targetBuild": { "const": "21020021" },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fact" }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status", "value", "unit", "confidence", "tolerance", "method", "sources"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["confirmed", "estimate", "open"] },
        "value": {},
        "unit": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "unit"],
          "properties": {
            "kind": { "enum": ["exact", "absolute", "range", "behavioral"] },
            "value": {},
            "unit": { "type": "string", "minLength": 1 }
          }
        },
        "method": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
