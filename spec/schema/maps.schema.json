{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricochet.local/schema/maps.schema.json",
  "title": "RICOCHET clean-room vanilla arena catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "targetBuild", "targetVersion", "catalogCount", "units", "geometryVocabulary", "reconciliation", "representativeExamples", "maps"],
  "properties": {
    "$schema": { "const": "./schema/maps.schema.json" },
    "schemaVersion": { "const": 2 },
    "targetBuild": { "const": "21020021" },
    "targetVersion": { "const": "v1.1.2.a75ee335a" },
    "catalogCount": { "const": 70 },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distance", "time", "sourcePlayerDiameterPixels", "sourceMaskPixels"],
      "properties": {
        "distance": { "const": "player-diameters" },
        "time": { "const": "60-hz-ticks" },
        "sourcePlayerDiameterPixels": { "const": 18 },
        "sourceMaskPixels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": { "width": { "const": 640 }, "height": { "const": 360 } }
        }
      }
    },
    "geometryVocabulary": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/vocabularyEntry" }
    },
    "reconciliation": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/reconciliation" }
    },
    "representativeExamples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static", "movingCandidate", "breakableCandidate", "hazard", "asymmetric", "ringOut"],
      "properties": {
        "static": { "$ref": "#/$defs/id" },
        "movingCandidate": { "$ref": "#/$defs/id" },
        "breakableCandidate": { "$ref": "#/$defs/id" },
        "hazard": { "$ref": "#/$defs/id" },
        "asymmetric": { "$ref": "#/$defs/id" },
        "ringOut": { "$ref": "#/$defs/id" }
      }
    },
    "maps": {
      "type": "array",
      "minItems": 70,
      "items": { "$ref": "#/$defs/map" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xMin", "xMax", "yMin", "yMax"],
      "properties": {
        "xMin": { "type": "number", "minimum": -40 },
        "xMax": { "type": "number", "minimum": -40 },
        "yMin": { "type": "number", "minimum": -40 },
        "yMax": { "type": "number", "minimum": -40 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence", "method", "tolerance", "sources"],
      "properties": {
        "status": { "enum": ["confirmed", "provisional", "conflict", "unknown"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "method": { "type": "string", "minLength": 1 },
        "tolerance": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "vocabularyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "purpose": { "type": "string", "minLength": 1 } }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reportedCount", "relationship", "notes"],
      "properties": {
        "source": { "$ref": "#/$defs/id" },
        "reportedCount": { "type": "integer", "minimum": 0 },
        "relationship": { "enum": ["lower-bound", "exact-preview-index", "observed-subset"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "visualEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "previewSha256", "previewPixels", "rowAnchorMethod"],
      "properties": {
        "source": { "$ref": "#/$defs/id" },
        "previewSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "previewPixels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": { "width": { "const": 640 }, "height": { "const": 360 } }
        },
        "rowAnchorMethod": { "const": "xlsx-drawing-one-cell-anchor" }
      }
    },
    "maskEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "maskSha256", "sourceForegroundPixels", "renderedForegroundPixels", "intersectionPixels", "unionPixels", "intersectionOverUnion"],
      "properties": {
        "threshold": { "const": "max-rgb-greater-than-or-equal-to-24" },
        "maskSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceForegroundPixels": { "type": "integer", "minimum": 1 },
        "renderedForegroundPixels": { "type": "integer", "minimum": 1 },
        "intersectionPixels": { "type": "integer", "minimum": 1 },
        "unionPixels": { "type": "integer", "minimum": 1 },
        "intersectionOverUnion": { "type": "number", "minimum": 0.95 }
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "xMin", "xMax", "yMin", "yMax", "clearanceDiameters", "supportPrimitiveId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "xMin": { "type": "number", "minimum": -40 },
        "xMax": { "type": "number", "minimum": -40 },
        "yMin": { "type": "number", "minimum": -40 },
        "yMax": { "type": "number", "minimum": -40 },
        "clearanceDiameters": { "type": "number", "minimum": 1 },
        "supportPrimitiveId": { "$ref": "#/$defs/id" }
      }
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primitive", "role", "x", "y", "width", "height", "rotationDegrees"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "primitive": { "const": "oriented-box" },
        "role": { "enum": ["static", "hazard-visual"] },
        "x": { "type": "number", "minimum": -40 },
        "y": { "type": "number", "minimum": -40 },
        "width": { "type": "number", "minimum": 0.001 },
        "height": { "type": "number", "minimum": 0.001 },
        "rotationDegrees": { "type": "number", "minimum": -45 }
      }
    },
    "behaviorModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "evidenceStatus", "timingStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["breakable-field", "moving-assembly", "physics-assembly", "radial-saw"] },
        "evidenceStatus": { "enum": ["visible", "visual-candidate"] },
        "timingStatus": { "enum": ["known", "unknown"] },
        "bounds": { "$ref": "#/$defs/bounds" },
        "x": { "type": "number", "minimum": -40 },
        "y": { "type": "number", "minimum": -40 },
        "radius": { "type": "number", "minimum": 0.001 }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceRow", "visualEvidence", "maskEvidence", "archetype", "symmetry", "ringOutFocused", "cameraBounds", "collisionBounds", "killBoundaryY", "spawnRegions", "primitives", "behaviorModules", "provenance", "unknowns"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceRow": { "type": "integer", "minimum": 2 },
        "visualEvidence": { "$ref": "#/$defs/visualEvidence" },
        "maskEvidence": { "$ref": "#/$defs/maskEvidence" },
        "archetype": { "enum": ["visible-platform-layout", "ring-out-islands", "breakable-candidate", "moving-candidate", "physics-candidate", "hazard-course"] },
        "symmetry": { "enum": ["mirror", "near-mirror", "asymmetric"] },
        "ringOutFocused": { "type": "boolean" },
        "cameraBounds": { "$ref": "#/$defs/bounds" },
        "collisionBounds": { "$ref": "#/$defs/bounds" },
        "killBoundaryY": { "type": "number", "minimum": -40 },
        "spawnRegions": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/spawn" } },
        "primitives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/primitive" } },
        "behaviorModules": { "type": "array", "items": { "$ref": "#/$defs/behaviorModule" } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "unknowns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
