{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricochet.local/schema/cards.schema.json",
  "title": "ROUNDS clean-room vanilla card catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetBuild", "targetVersion", "catalogCount", "reconciliation", "patchHistory", "evaluationOrder", "sourceExclusions", "stackingCases", "cards"],
  "properties": {
    "$schema": { "const": "./schema/cards.schema.json" },
    "schemaVersion": { "const": 1 },
    "targetBuild": { "const": "21020021" },
    "targetVersion": { "const": "v1.1.2.a75ee335a" },
    "catalogCount": { "const": 67 },
    "reconciliation": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/reconciliation" }
    },
    "patchHistory": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/patchHistory" }
    },
    "evaluationOrder": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evaluationPhase" }
    },
    "sourceExclusions": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceExclusion" }
    },
    "stackingCases": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/stackingCase" }
    },
    "cards": {
      "type": "array",
      "minItems": 67,
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence", "method", "tolerance", "sources"],
      "properties": {
        "status": { "enum": ["confirmed", "provisional", "conflict", "unknown"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "method": { "type": "string", "minLength": 1 },
        "tolerance": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" }
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reportedCount", "relationship", "notes"],
      "properties": {
        "source": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "reportedCount": { "type": "integer", "minimum": 0 },
        "relationship": { "enum": ["exact", "lower-bound", "missing-entry", "observed-subset"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "stackingCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "resolution", "cardId", "effectId", "rule", "provenance"],
      "properties": {
        "operator": { "enum": ["additive", "multiplicative", "count", "max-wins", "hook"] },
        "resolution": { "enum": ["confirmed", "provisional", "unresolved"] },
        "cardId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "effectId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "rule": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "patchHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date", "source", "scope", "binding"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "source": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "scope": { "type": "string", "minLength": 1 },
        "binding": { "type": "string", "minLength": 1 }
      }
    },
    "evaluationPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "phase", "rule"],
      "properties": {
        "order": { "type": "integer", "minimum": 0 },
        "phase": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "sourceExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "cardId", "fact", "reason"],
      "properties": {
        "source": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "cardId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "fact": { "type": "string", "pattern": "^(metadata|behavior|effect:(\\*|[a-z0-9]+(?:-[a-z0-9]+)*))$" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "hook", "provenance"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "hook": { "enum": ["passive", "on-block", "on-damage-dealt", "on-damage-taken", "on-fire", "on-impact", "on-bounce", "on-reload", "on-empty", "on-death", "on-still", "conditional"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "operation", "value", "unit", "stacking", "order", "cap", "provenance", "stackingProvenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "target": { "type": "string", "pattern": "^[a-z]+(?:[.-][a-z0-9]+)+$" },
        "operation": { "enum": ["add-flat", "add-percent", "multiply", "add-count", "max-wins", "register-hook"] },
        "value": { "type": "number" },
        "unit": { "enum": ["percent", "factor", "seconds", "count", "metres", "hit-points", "presence", "damage-points"] },
        "stacking": { "enum": ["additive", "multiplicative", "count", "max-wins", "hook-per-copy", "unresolved"] },
        "order": { "type": "integer", "minimum": 0 },
        "cap": { "enum": ["none-observed", "source-defined", "unknown"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "stackingProvenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "originalName", "rarity", "draftAvailability", "implementationTier", "metadataProvenance", "behavior", "effects", "unknowns"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "originalName": { "type": "string", "minLength": 1 },
        "rarity": { "enum": ["common", "uncommon", "rare"] },
        "draftAvailability": { "enum": ["available", "unresolved"] },
        "implementationTier": { "enum": ["stat-only", "projectile", "conditional", "hook-heavy", "lifecycle"] },
        "metadataProvenance": { "$ref": "#/$defs/provenance" },
        "behavior": { "$ref": "#/$defs/behavior" },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/effect" }
        },
        "unknowns": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
